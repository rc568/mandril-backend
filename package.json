{
  "name": "mandril-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json",
    "start": "node ./dist/index.js",
    "dev": "clear && nodemon --exec tsx src/index.ts",
    "db:push": "drizzle-kit push",
    "db:push:test": "dotenv -e .env.test drizzle-kit push",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --apply .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.4",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.4",
    "env-var": "^7.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.1.10",
    "supertest": "7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  }
}
